    <string name="fast_capture_service_description">Takes one screenshot only when you trigger MiCTS. It does not read window content, observe accessibility events, perform gestures, or display overlays.</string>
    <string name="fast_capture_setup_title">Set up Fast capture</string>
    <string name="fast_capture_setup_message">Enable MiCTS Fast capture once in Android Accessibility settings. After that, launcher and Quick Settings triggers can capture without another screen-sharing dialog.</string>
    <string name="fast_capture_privacy_disclosure">MiCTS takes one screenshot only after you explicitly trigger it. The service does not inspect windows, receive accessibility events, perform gestures, show overlays, or run captures by itself. It remains enabled until you turn it off in Android settings.</string>
